{
  "version": "2.0.0",
  "tasks": [
    {
      // Runs main.py on the board every time it is saved, and reports what
      // it did. In a Codespace this is also the default terminal, so it
      // starts by itself. This task is for running it by hand.
      "label": "cyberdeck",
      "type": "shell",
      "command": "python3 .vscode/autorun.py",
      "isBackground": true,
      "presentation": {
        "reveal": "always", "focus": true, "panel": "dedicated",
        "group": "wokwi", "clear": true
      },
      "problemMatcher": [],
      "detail": "Save main.py (Cmd+S or Ctrl+S) and it runs on the board. Read the output in the Wokwi Terminal."
    },
    {
      "label": "Send code now",
      "type": "shell",
      // Asks the running watcher to run main.py again. Same as saving the
      // file without changing it.
      "command": "python3 .vscode/autorun.py --once",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "wokwi" },
      "detail": "Run main.py again without changing it. Read the output in the Wokwi Terminal."
    }
  ]
}
