{
  "version": "2.0.0",
  "tasks": [
    {
      // Watches for the simulator and sends main.py the moment you press
      // Start. Runs on folder open where VS Code allows automatic tasks, and
      // is started by the dev container in a Codespace.
      // Named for where to look, not for what it does. This label is the
      // terminal's name in the panel, and Wokwi opens a terminal of its own
      // that is always empty here, so the participant has to be able to tell
      // the two apart at a glance.
      "label": "Board output",
      "type": "shell",
      "command": "python3 .vscode/autorun.py",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "always", "focus": true, "panel": "dedicated",
        "group": "wokwi", "clear": true
      },
      "problemMatcher": [],
      "detail": "Press Start in the Wokwi tab. Your code runs and prints here. Press Enter here to run it again."
    },
    {
      "label": "Send code now",
      "type": "shell",
      // Goes through the same script, so it installs mpremote on first use
      // rather than failing with "No module named mpremote". When the watcher
      // is running this only asks it to re-send, and the output stays in
      // "Board output". Same as pressing Enter there.
      "command": "python3 .vscode/autorun.py --once",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "wokwi" },
      "detail": "Send main.py again, in \"Board output\". Same as pressing Enter there. Use it after a Restart in Wokwi."
    },
    {
      "label": "Open a MicroPython prompt",
      "type": "shell",
      "command": "python3 .vscode/autorun.py --repl",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "wokwi" },
      "detail": "Type Python straight at the board. Ctrl-] to leave."
    }
  ]
}
