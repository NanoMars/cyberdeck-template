{
  "version": "2.0.0",
  "tasks": [
    {
      // Watches for the simulator and sends main.py the moment you press
      // Start. Runs on folder open where VS Code allows automatic tasks, and
      // is started by the dev container in a Codespace.
      "label": "Send code on simulator start",
      "type": "shell",
      "command": "python3 .vscode/autorun.py",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "wokwi", "clear": true },
      "problemMatcher": [],
      "detail": "Press Start in the Wokwi tab and your code is sent automatically."
    },
    {
      "label": "Send code now",
      "type": "shell",
      // Goes through the same script, so it installs mpremote on first use
      // rather than failing with "No module named mpremote".
      "command": "python3 .vscode/autorun.py --once",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "wokwi" },
      "detail": "Send main.py right now. The simulator must already be running."
    },
    {
      "label": "Open a MicroPython prompt",
      "type": "shell",
      "command": "python3 .vscode/autorun.py --repl",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "wokwi" },
      "detail": "Type Python straight at the board. Ctrl-] to leave."
    }
  ]
}
