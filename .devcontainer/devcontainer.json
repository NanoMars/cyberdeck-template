{
  "name": "cyberdeck",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Wait for postStartCommand before the editor attaches. Without this the
  // Hackatime extension activates first, finds no key, and shows a modal.
  "waitFor": "postStartCommand",

  "postCreateCommand": "pip install --user -r requirements.txt",
  "postStartCommand": "bash .devcontainer/setup-hackatime.sh",

  // The watcher starts here, on every attach, in the foreground. The
  // lifecycle runner shows the command in a "Codespaces" terminal and keeps
  // it alive for as long as that terminal exists. Detaching it instead, with
  // nohup or setsid, did not work: the runner killed the detached process
  // as soon as the command returned, measured in fresh Codespaces on
  // 2026-09-18. On a reattach a new copy starts and the takeover in
  // autorun.py makes the old one exit. Output also goes to a log, which the
  // default terminal below follows.
  "postAttachCommand": "python3 .vscode/autorun.py",

  "customizations": {
    "vscode": {
      "extensions": [
        "hackatime.hackatime-time-tracker",
        "Wokwi.wokwi-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "hackatime.apiUrl": "https://hackatime.hackclub.com/api/hackatime/v1",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        // Stubs are vendored in typings/, so this needs no install path.
        "python.analysis.stubPath": "typings",
        "python.analysis.diagnosticSeverityOverrides": {
          "reportMissingModuleSource": "none"
        },
        // Every new terminal starts as "cyberdeck": it follows the watcher's
        // log, or becomes the watcher if none is running. Ctrl-C drops to a
        // plain shell. The program's output is in the Wokwi Terminal; this
        // one only reports status. Plain bash stays in the dropdown.
        "terminal.integrated.profiles.linux": {
          "cyberdeck": {
            "path": "bash",
            "args": ["-lc", "python3 .vscode/autorun.py --follow; exec bash -l"],
            "icon": "circuit-board"
          },
          "bash": { "path": "bash", "icon": "terminal-bash" }
        },
        "terminal.integrated.defaultProfile.linux": "cyberdeck",
        // Let the watcher name its own tab "cyberdeck". Other terminals keep
        // the name their shell sets.
        "terminal.integrated.tabs.title": "${sequence}",
        // Saving is what runs main.py on the board. With autosave on, a pause
        // in typing would run half-written code. Armand chose an explicit
        // Cmd+S on 2026-09-17.
        "files.autoSave": "off",
        "remote.autoForwardPorts": false,
        "files.exclude": { "**/__pycache__": true }
      }
    },
    "codespaces": {
      "openFiles": ["main.py"]
    }
  },

  "remoteEnv": {
    // Read by the Hackatime extension if the config file is ever missing.
    "HACKATIME_API_KEY": "${localEnv:HACKATIME_API_KEY}"
  },

  // The Wokwi serial port is deliberately NOT forwarded.
  //
  // forwardPorts makes the VS Code server bind the port itself, from the
  // moment the container starts. That breaks the watcher twice over: a plain
  // TCP connect to it always succeeds, so it thinks the simulator is running
  // and hangs trying to talk to a socket that accepts and never answers; and
  // Wokwi cannot bind the port it needs for its own serial server.
  //
  // Nothing outside the container needs that port. Wokwi's serial server and
  // mpremote are both inside it and talk over localhost.
  // VS Code also forwards any port it sees a process listening on. Nothing
  // outside the container needs the watcher's lock port or Wokwi's serial
  // port, and a forwarder holding one of them is one way to get
  // "EADDRINUSE :::47322" from Wokwi. So do not forward anything by itself.
  "portsAttributes": {
    "47321": { "label": "cyberdeck watcher", "onAutoForward": "ignore" },
    "47322": { "label": "Wokwi serial", "onAutoForward": "ignore" }
  }
}
